# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored; .env.example is the committed template.
# Loaded by docker-compose.yml (env_file: .env) for both the db and web services.

# --- PostgreSQL ---
# Consumed by the Postgres image (POSTGRES_*) to initialise the database,
# and by Django (DATABASE_*) in cabportal/settings.py to connect.
# Keep the DB name / user / password consistent across both sets.
POSTGRES_DB=cabportal
POSTGRES_USER=cabportal
POSTGRES_PASSWORD=testpassword

DATABASE_NAME=cabportal
DATABASE_USER=cabportal
DATABASE_PASSWORD=testpassword
# Used by entrypoint.sh to wait for Postgres before running migrations.
# DATABASE_HOST must match the compose service name ("db"); PORT is the
# in-container port (5432), not the host-published port.
DATABASE=postgres
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Google Sign-In ---
# OAuth 2.0 Web-application Client ID from the Google Cloud Console.
# Must match the client_id the frontend uses so verify_oauth2_token()'s
# audience check passes (cabportal/settings.py, main/views.py GoogleLogin).
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
